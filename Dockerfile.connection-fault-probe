# Test-only image: the production worker binary is unchanged.
FROM golang:1.26-alpine AS build
RUN apk add --no-cache ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/connection-worker ./cmd/connection-worker
RUN CGO_ENABLED=0 go test -c -o /out/connection-fault-probe ./internal/connections

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
COPY --from=build /out/connection-worker /out/connection-fault-probe /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["connection-fault-probe"]
