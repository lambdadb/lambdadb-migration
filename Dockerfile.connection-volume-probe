FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go test -c -o /probe ./internal/connections

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /probe /probe
USER 65532:65532
ENTRYPOINT ["/probe", "-test.v", "-test.run=^TestStateVolumeProbe$", "-test.timeout=20m"]
