# Local/CI-only syscall crash qualification. Never deploy this image as a worker.
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go vet ./internal/connections
RUN CGO_ENABLED=0 go test -c -o /out/commit-crash-probe ./internal/connections
FROM alpine:3.23
RUN apk add --no-cache strace
COPY --from=build /out/commit-crash-probe /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["commit-crash-probe"]
