FROM golang:1.26-alpine AS build
RUN apk add --no-cache ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go test -c -o /out/connection-s3-probe ./internal/statefile

FROM alpine:3.23
RUN apk add --no-cache ca-certificates
COPY --from=build /out/connection-s3-probe /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["connection-s3-probe"]
CMD ["-test.run=^TestLiveS3StatePermissions$", "-test.v", "-test.timeout=2m"]
